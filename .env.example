# Application
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for Clerk session handling and server-side authentication.
# Copy the values from your Clerk dashboard for local development or production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
CLERK_SIGN_IN_URL=/login
CLERK_SIGN_UP_URL=/sign-up

# AI review-draft generation (Feature 03)
# Provider-agnostic — current development provider is "mock" (returns a safe static draft).
# No API keys are required for the mock provider. Real provider integration is deferred.
AI_PROVIDER=mock
AI_MOCK_DRAFT=I recently used RM Solution and was impressed by the quality of their work. The team was professional and delivered exactly what I needed. I would definitely recommend them to others looking for reliable business solutions.

# Google Business Profile Connection (Feature 04)
# Provider-agnostic — default development provider is "mock" (deterministic mock data).
# Set to "google" when live Google Cloud credentials and Business Profile API approval are available.
GOOGLE_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
TOKEN_ENCRYPTION_SECRET=development-secret-key-32-chars-min!

