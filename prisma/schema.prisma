generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User accounts in the system.
model User {
  id          String             @id @default(cuid())
  email       String             @unique
  name        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  auditLogs   AuditLog[]
}

/// Tenants (businesses/organizations) in the multi-tenant system.
model Tenant {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  publicToken String             @unique @default(cuid())
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  auditLogs   AuditLog[]
}

/// Membership linking users to tenants with a role.
model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   /// OWNER | ADMIN | STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

/// Audit log for security and business-action history.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  details   String?  /// JSON details (no secrets)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}
