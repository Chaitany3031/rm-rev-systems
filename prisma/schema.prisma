generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User accounts in the system.
model User {
  id          String             @id @default(cuid())
  email       String             @unique
  name        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  auditLogs   AuditLog[]
}

/// Tenants (businesses/organizations) in the multi-tenant system.
model Tenant {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  publicToken         String               @unique @default(cuid())
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         TenantMembership[]
  auditLogs           AuditLog[]
  services            Service[]
  feedbackSubmissions FeedbackSubmission[]
  reviewDrafts        ReviewDraft[]
  reviewReplyDrafts   ReviewReplyDraft[]
  googleConnection    GoogleConnection?
  googleReviews       GoogleReview[]
}

/// Membership linking users to tenants with a role.
model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   /// OWNER | ADMIN | STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

/// Audit log for security and business-action history.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  details   String?  /// JSON details (no secrets)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// Tenant-owned services in the business service catalog.
model Service {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedbackServices FeedbackService[]

  @@index([tenantId, isActive])
}

/// Public customer feedback submission.
model FeedbackSubmission {
  id        String   @id @default(cuid())
  tenantId  String
  rating    Int      /// Overall rating (1-5)
  feedback  String?  /// Optional customer written feedback
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  selectedServices FeedbackService[]
  reviewDrafts     ReviewDraft[]

  @@index([tenantId])
}

/// Join model capturing services selected during a feedback submission.
/// Stores a snapshot of the service name at submission time to preserve historical integrity.
model FeedbackService {
  id                   String   @id @default(cuid())
  feedbackSubmissionId String
  serviceId            String
  serviceName          String   /// Historical snapshot of service name
  createdAt            DateTime @default(now())

  feedbackSubmission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  service            Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([feedbackSubmissionId, serviceId])
  @@index([serviceId])
}

/// AI-generated review draft derived from a customer feedback submission.
/// The draft is always the latest generated draft for its submission. It deliberately
/// keeps the original `FeedbackSubmission.feedback` unchanged and stores the editable
/// AI-generated text separately. Editing the draft in the UI mutates this record only.
model ReviewDraft {
  id                   String             @id @default(cuid())
  tenantId             String
  feedbackSubmissionId String
  draft                String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedbackSubmission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)

  @@unique([feedbackSubmissionId])
  @@index([tenantId])
}

/// AI-generated reply draft for a Google review.
/// A single current draft per (tenant, googleReview) pair.
/// The draft is separate from GoogleReview.replyComment and
/// must never be published by Feature 06.
model ReviewReplyDraft {
  id                String             @id @default(cuid())
  tenantId          String
  googleReviewId    String
  content           String
  provider          String?
  model             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  googleReview     GoogleReview       @relation(fields: [googleReviewId], references: [id], onDelete: Cascade)

  @@unique([tenantId, googleReviewId])
  @@index([tenantId])
}

/// Google Business Profile connection for a tenant.
/// Persists OAuth connection status, authorized Google account and location identifiers,
/// location metadata for display, and securely encrypted OAuth credentials.
/// Sensitive credentials (access/refresh tokens) must be stored encrypted and never exposed.
model GoogleConnection {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  provider              String    @default("google")
  googleAccountId       String?   /// Resource name or ID e.g. "accounts/123456"
  googleAccountName     String?   /// Display name of Google Account
  googleLocationId      String?   /// Resource name or ID e.g. "locations/789012"
  googleLocationName    String?   /// Full resource name e.g. "accounts/123/locations/789"
  locationTitle         String?   /// Business name of the selected location
  locationAddress       String?   /// Formatted storefront address
  status                String    @default("CONNECTED") /// CONNECTED | DISCONNECTED | ERROR
  errorMessage          String?   /// Sanitized error description if in ERROR status
  scope                 String?   /// Authorized OAuth scopes
  encryptedAccessToken  String?   /// AES-256-GCM encrypted access token
  encryptedRefreshToken String?   /// AES-256-GCM encrypted refresh token
  tokenExpiresAt        DateTime? /// Expiration time for access token
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  googleReviews GoogleReview[]

  @@index([tenantId, status])
}

/// Google Business Profile review synchronized from Google's Review API.
/// Stores a normalized snapshot of review data for tenant-scoped review inbox.
/// The stable identity is (tenantId + googleReviewName) to support idempotent synchronization.
/// Reviews are updated (not duplicated) on repeated synchronization.
model GoogleReview {
  id                  String    @id @default(cuid())
  tenantId            String
  googleConnectionId  String
  googleReviewName    String    /// Stable Google review resource name e.g. "accounts/123/locations/456/reviews/789"
  googleLocationName  String    /// Google location resource name
  reviewerDisplayName String?   /// Reviewer's display name (if available)
  starRating          Int?      /// 1-5 star rating
  comment             String?   @db.Text /// Review comment text
  reviewCreateTime    DateTime? /// When the review was originally created on Google
  reviewUpdateTime    DateTime? /// When the review was last updated on Google
  replyComment        String?   @db.Text /// Existing reply text (if merchant already replied)
  replyUpdateTime     DateTime? /// When the reply was last updated
  reviewReplyUrl      String?   /// URL to reply to this review on Google
  replyState          String?   /// Current reply state from Google
  policyViolationCode String?   /// Policy violation code if flagged by Google
  syncedAt            DateTime  @default(now()) /// Last synchronization timestamp
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  googleConnection GoogleConnection   @relation(fields: [googleConnectionId], references: [id], onDelete: Cascade)
  replyDrafts      ReviewReplyDraft[]

  @@unique([tenantId, googleReviewName])
  @@index([tenantId, googleConnectionId, reviewUpdateTime])
}
